# Environment variables read by the backend (backend/app/core/config.py). All are optional for the local demo.
# Set them in your shell or deployment config; the app does not auto-load .env files.

# Database: SQLite file by default; use PostgreSQL in production.
# SAHARA_DB_URL=postgresql+psycopg://sahara:change-me@localhost:5432/sahara

# JWT signing secret. The built-in default is for local development only.
# SAHARA_JWT_SECRET=replace-with-a-long-random-secret

# Log level for console and rotating files in backend/logs/
# SAHARA_LOG_LEVEL=INFO
